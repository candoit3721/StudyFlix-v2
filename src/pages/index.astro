---
import Avatar from '../components/Avatar.astro';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/content';

const { learners } = await getCatalog();
---

<Base title="StudyFlix">
  <script is:inline slot="head">
    // Decide before first paint whether the big S intro plays, so the picker never flashes first.
    // It plays once per tab session, never under reduced motion, and never without JavaScript.
    (() => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const key = 'studyflix:v2:intro-seen';
      try {
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, '1');
      } catch {}
      document.documentElement.dataset.intro = 'play';
    })();
  </script>

  <div class="intro" aria-hidden="true" data-intro-overlay>
    <span class="intro-mark">S</span>
  </div>

  <section class="chooser wrap">
    <h1>Who's learning today?</h1>
    <ul class="chooser-list">
      {
        learners.map((learner) => (
          <li>
            <a class="chooser-option" href={learner.url}>
              <Avatar avatar={learner.avatar} accent={learner.accent} size="xl" />
              <span class="chooser-name">{learner.name}</span>
              <span class="chooser-tagline">{learner.tagline}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="chooser-note" data-sync-note hidden>
      Progress is saved on this device only. A parent can sign in so it follows every learner to every
      device. <a href="/account/">Family sign-in</a>
    </p>
  </section>
</Base>

<script>
  import { onSyncState } from '../lib/sync/engine';

  // Shown only once the engine has confirmed there is no session, so a signed-in device never flashes it.
  const note = document.querySelector<HTMLElement>('[data-sync-note]');
  onSyncState((state) => {
    if (note) note.hidden = state.status !== 'signed-out';
  });
</script>

<style>
  .chooser {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height) - 7rem);
    padding-block: 3rem;
    text-align: center;
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .chooser-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.25rem, 1rem + 2vw, 2.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chooser-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    padding: 0.5rem;
  }

  /* The white frame around the tile and the white name are the focus indicator. */
  .chooser-option:focus-visible {
    outline: none;
  }

  .chooser-option:hover :global(.avatar),
  .chooser-option:focus-visible :global(.avatar) {
    box-shadow: 0 0 0 var(--tile-frame) var(--text);
  }

  .chooser-name {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .chooser-option:hover .chooser-name,
  .chooser-option:focus-visible .chooser-name {
    color: var(--text);
  }

  .chooser-tagline {
    color: var(--text-faint);
    font-size: var(--step--1);
  }
</style>

<script>
  /** Ends the big S intro when its animation finishes, or at once on any key or pointer press. */
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro-overlay]');

  if (intro && root.dataset.intro === 'play') {
    const events = ['keydown', 'pointerdown', 'pagehide'] as const;
    let backstop: ReturnType<typeof setTimeout> | undefined;
    const end = () => {
      delete root.dataset.intro;
      intro.hidden = true;
      clearTimeout(backstop);
      for (const type of events) window.removeEventListener(type, end, true);
    };
    // In case animationend never fires, for example in a tab opened in the background.
    const seconds = Number.parseFloat(getComputedStyle(root).getPropertyValue('--intro-duration')) || 1.6;
    backstop = setTimeout(end, seconds * 1000 + 300);
    intro.addEventListener('animationend', (event) => {
      if (event.target === intro) end();
    });
    for (const type of events) window.addEventListener(type, end, true);
  }
</script>
